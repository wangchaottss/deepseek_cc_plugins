{
  "hooks": {
    "UserPromptSubmit": [
      {
        "description": "Record every user prompt as a task and inject tracking instructions",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/hook-up.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "description": "Block session stop until task finish is called",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/hook-stop.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
